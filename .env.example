# Escape from Red Hat — copy to .env and fill in. Keys stay server-side; the browser never sees them.
# Shell environment variables override this file.

# Which decision provider drives the people: openai-compatible | scripted
#   scripted = labeled fixture for UI work / tests (NOT a model; the UI says so)
PLANNER_PROVIDER=openai-compatible

# ── Profile A (default): hosted OpenAI API ────────────────────────────────────────────────────────────────────────
# Only an API key is needed. The endpoint kind is detected from the URL (hosted-api): no vLLM-only fields are sent,
# and parallel_tool_calls=false so each decision returns one tool call.
PLANNER_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-4.1
PLANNER_API_KEY=sk-...
PLANNER_LABEL="GPT-4.1"
# GPT-4.1 has no reasoning channel, so there is no reasoning text to show.
PLANNER_AGENT_THINKING=false

# ── Profile B: self-hosted Nemotron 3.5 Lightning on vLLM (Brev H100) ─────────────────────────────────────────────
# Setup and runbook: deploy/README.md and deploy/vllm/. Comment out profile A and uncomment these.
# PLANNER_BASE_URL=http://127.0.0.1:8001/v1         # brev port-forward escape-nemotron --port 8001:8000
# PLANNER_MODEL=escape-nemotron                     # = vLLM --served-model-name
# PLANNER_API_KEY=<ESCAPE_VLLM_KEY from the VM's server.env — never commit it>
# PLANNER_LABEL="Nemotron 3.5 Lightning 30B-A3B"
# PLANNER_AGENT_THINKING=true                       # reasoning on; its text shows in the trace panel
# PLANNER_AGENT_THINKING_BUDGET=128                 # cap reasoning tokens per decision (vLLM thinking_token_budget; 0 = no cap)

# ── Decision mode ─────────────────────────────────────────────────────────────────────────────────────────────────
# agents (this project's mode) = each person (Alex, Maya, Daniel, Rosa, Kenji) makes their own model call from what
# they personally know; the engine's hard-coded reflexes are off.
# central = one planner call directs everyone (kept for the tests and the scripted fixture).
PLANNER_MODE=agents
# Hold the sim clock while anyone is deciding (true), or let the fire keep spreading in real time (false).
PLANNER_AGENT_FREEZE_WHILE_THINKING=false
# Safety stop per run, all five people combined (not a game rule; there is no time limit).
PLANNER_AGENT_MAX_DECISIONS=250

# ── Generation settings ───────────────────────────────────────────────────────────────────────────────────────────
PLANNER_TEMPERATURE=0.6
PLANNER_TOP_P=0.95
PLANNER_MAX_TOKENS=1024
# Per-decision timeout; a timed-out call is retried once.
PLANNER_DEADLINE_MS=20000
# Prompt/harness version (v2 = improved tool guidance + recovery hints; v1 = baseline)
PLANNER_HARNESS=v2

# ── Server ────────────────────────────────────────────────────────────────────────────────────────────────────────
PORT=8787
DEMO_CASE=demo-hero
