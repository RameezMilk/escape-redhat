# Escape from Red Hat — copy to .env and fill in. Keys stay server-side; the browser never sees them.

# Which decision provider drives the planner: openai-compatible | scripted
#   scripted = labeled fixture for UI work / tests (NOT a model; the UI says so)
PLANNER_PROVIDER=scripted

# OpenAI-compatible chat-completions endpoint serving Nemotron 3.5 Lightning 30B-A3B
# Self-hosted vLLM on Brev (final demo):
#   PLANNER_BASE_URL=http://127.0.0.1:8001/v1        (brev port-forward escape-nemotron --port 8001:8000)
#   PLANNER_MODEL=escape-nemotron                    (= --served-model-name)
#   PLANNER_API_KEY=<ESCAPE_VLLM_KEY from the VM's server.env — never commit it>
#   PLANNER_ENDPOINT_KIND=self-hosted-vllm
# Hosted NVIDIA API Catalog (development scaffold, same weights):
#   PLANNER_BASE_URL=https://integrate.api.nvidia.com/v1
#   PLANNER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#   PLANNER_API_KEY=nvapi-...
#   PLANNER_ENDPOINT_KIND=hosted-api
PLANNER_BASE_URL=http://127.0.0.1:8001/v1
PLANNER_MODEL=escape-nemotron
PLANNER_API_KEY=
PLANNER_ENDPOINT_KIND=self-hosted-vllm
PLANNER_LABEL="Nemotron 3.5 Lightning 30B-A3B"

# Generation settings
PLANNER_THINKING=false
PLANNER_TEMPERATURE=0.6
PLANNER_TOP_P=0.95
PLANNER_MAX_TOKENS=1024
# Hosted API Catalog latency was 30-50 s/call when measured (2026-10-17); use ~90000 there, ~20000 for self-hosted vLLM.
PLANNER_DEADLINE_MS=20000
# Send chat_template_kwargs (enable_thinking). Default: on for self-hosted vLLM, off for hosted APIs (the hosted
# Catalog hung on it when tested). Uncomment to force.
# PLANNER_TEMPLATE_KWARGS=true
# Live mode: freeze the simulation clock while the planner is thinking. Default on for hosted APIs (slow),
# off for self-hosted vLLM (sim time then includes real decision latency).
# PLANNER_FREEZE_WHILE_THINKING=true
# Decision cap per episode: a safety stop, not a game rule (there is no time limit).
PLANNER_MAX_DECISIONS=100
# Prompt/harness version (v2 = improved tool guidance + recovery hints; v1 = baseline)
PLANNER_HARNESS=v2

# Who decides. agents (this project's mode) = each person (Alex, Maya, Daniel, Rosa, Kenji) makes their own Nemotron
# call from what they personally know, reasoning on; the engine's hard-coded reflexes are off.
# central = one planner call directs everyone (kept for the tests and the scripted fixture).
PLANNER_MODE=agents
# PLANNER_AGENT_THINKING=true                 reasoning on (default)
# PLANNER_AGENT_THINKING_BUDGET=128           cap reasoning tokens per decision (vLLM thinking_token_budget; 0 = no cap)
# PLANNER_AGENT_MAX_DECISIONS=250             safety stop per run, all five people combined
# PLANNER_AGENT_FREEZE_WHILE_THINKING=true    hold the sim clock while anyone thinks (false = real-time pressure)

# Server
PORT=8787
DEMO_CASE=demo-hero
