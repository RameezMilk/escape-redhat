# Escape from Red Hat — copy to .env and fill in. Keys stay server-side; the browser never sees them.

# Which decision provider drives the planner: openai-compatible | scripted
#   scripted = labeled fixture for UI work / tests (NOT a model; the UI says so)
PLANNER_PROVIDER=scripted

# OpenAI-compatible chat-completions endpoint serving Nemotron 3.5 Lightning 30B-A3B
# Self-hosted vLLM on Brev (final demo):
#   PLANNER_BASE_URL=http://localhost:8000/v1        (via SSH tunnel / Brev port-forward)
#   PLANNER_MODEL=nemotron-3.5-lightning             (= --served-model-name)
#   PLANNER_API_KEY=<the --api-key you passed to vllm serve>
#   PLANNER_ENDPOINT_KIND=self-hosted-vllm
# Hosted NVIDIA API Catalog (development scaffold, same weights):
#   PLANNER_BASE_URL=https://integrate.api.nvidia.com/v1
#   PLANNER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#   PLANNER_API_KEY=nvapi-...
#   PLANNER_ENDPOINT_KIND=hosted-api
PLANNER_BASE_URL=http://localhost:8000/v1
PLANNER_MODEL=nemotron-3.5-lightning
PLANNER_API_KEY=
PLANNER_ENDPOINT_KIND=self-hosted-vllm
PLANNER_LABEL="Nemotron 3.5 Lightning 30B-A3B"

# Generation settings
PLANNER_THINKING=false
PLANNER_TEMPERATURE=0.6
PLANNER_TOP_P=0.95
PLANNER_MAX_TOKENS=1024
# Hosted API Catalog latency was 30-50 s/call when measured (2026-10-17); use ~90000 there, ~20000 for self-hosted vLLM.
PLANNER_DEADLINE_MS=20000
# Send chat_template_kwargs (enable_thinking). Default: on for self-hosted vLLM, off for hosted APIs (the hosted
# Catalog hung on it when tested). Uncomment to force.
# PLANNER_TEMPLATE_KWARGS=true
PLANNER_MAX_DECISIONS=24
# Prompt/harness version (v2 = improved tool guidance + recovery hints; v1 = baseline)
PLANNER_HARNESS=v2

# Server
PORT=8787
DEMO_CASE=demo-hero
